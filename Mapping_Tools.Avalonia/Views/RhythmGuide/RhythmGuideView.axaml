<views:SingleRunMappingTool xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:views="clr-namespace:Mapping_Tools.Avalonia.Views"
                            xmlns:c="clr-namespace:Mapping_Tools.Components"
                            xmlns:domain="clr-namespace:Mapping_Tools.Components.Domain"
                            xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                            x:Class="Mapping_Tools.Avalonia.Views.RhythmGuide.RhythmGuideView"
                            x:Name="This">
    <views:SingleRunMappingTool.Resources>
        <domain:StringArrayToStringConverter x:Key="StringArrayConverter"/>
        <domain:MapPathStringToCountStringConverter x:Key="PathCountConverter"/>
        <domain:BeatDivisorArrayToStringConverter x:Key="BeatDivisorConverter"/>
    </views:SingleRunMappingTool.Resources>
    <Grid Margin="20" RowDefinitions="*,Auto">
        <ScrollViewer>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="10">
                    <c:ViewHeaderComponent ParentControl="{Binding #This}" HorizontalAlignment="Left"/>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
                        <TextBox x:Name="ImportPathBox" Text="{Binding GuideGeneratorArgs.Paths, Converter={StaticResource StringArrayConverter}}"
                                 PlaceholderText="Copy rhythm from (separate paths with |)"/>
                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                   Text="{Binding #ImportPathBox.Text, Converter={StaticResource PathCountConverter}}"/>
                        <Button Grid.Column="2" Theme="{StaticResource IconButton}" Command="{Binding ImportLoadCommand}">
                            <icons:MaterialIcon Kind="RestoreFromTrash" Width="26" Height="26"/>
                        </Button>
                        <Button Grid.Column="3" Theme="{StaticResource IconButton}" Command="{Binding ImportBrowseCommand}">
                            <icons:MaterialIcon Kind="Folder" Width="26" Height="26"/>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Text="{Binding GuideGeneratorArgs.ExportPath}" PlaceholderText="Rhythm guide output map"/>
                        <Button Grid.Column="1" Theme="{StaticResource IconButton}" Command="{Binding ExportLoadCommand}">
                            <icons:MaterialIcon Kind="RestoreFromTrash" Width="26" Height="26"/>
                        </Button>
                        <Button Grid.Column="2" Theme="{StaticResource IconButton}" Command="{Binding ExportBrowseCommand}">
                            <icons:MaterialIcon Kind="Folder" Width="26" Height="26"/>
                        </Button>
                    </Grid>
                    <ComboBox ItemsSource="{Binding ExportModes}" SelectedItem="{Binding GuideGeneratorArgs.ExportMode}" Width="320" HorizontalAlignment="Left" PlaceholderText="Export mode"/>
                    <ComboBox ItemsSource="{Binding ExportGameModes}" SelectedItem="{Binding GuideGeneratorArgs.OutputGameMode}" Width="320" HorizontalAlignment="Left" PlaceholderText="Output game mode"/>
                    <TextBox Text="{Binding GuideGeneratorArgs.OutputName}" Width="320" HorizontalAlignment="Left" PlaceholderText="Output difficulty name"/>
                    <CheckBox Content="New combo on every object" IsChecked="{Binding GuideGeneratorArgs.NcEverything}"/>
                    <ComboBox ItemsSource="{Binding SelectionModes}" SelectedItem="{Binding GuideGeneratorArgs.SelectionMode}" Width="320" HorizontalAlignment="Left" PlaceholderText="Selection mode"/>
                    <c:ValidatedTextBox Width="320" HorizontalAlignment="Left" PlaceholderText="Beat divisors"
                                        Value="{Binding GuideGeneratorArgs.BeatDivisors}" Converter="{StaticResource BeatDivisorConverter}"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Margin="10"
                        Theme="{StaticResource MaterialDesignFloatingActionButton}"
                        IsEnabled="{Binding #This.CanRun}" Click="Start_Click">
                    <icons:MaterialIcon Kind="Play" Height="30" Width="30"/>
                </Button>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock Text="Made by OliBomby" FontWeight="Bold" Opacity="0.58"/>
            <ProgressBar Grid.Column="1" Margin="20,0" Height="20" Value="{Binding #This.Progress}"/>
        </Grid>
    </Grid>
</views:SingleRunMappingTool>
