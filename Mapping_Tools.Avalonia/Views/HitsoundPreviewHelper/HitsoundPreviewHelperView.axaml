<views:SingleRunMappingTool xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:views="clr-namespace:Mapping_Tools.Avalonia.Views"
                            xmlns:c="clr-namespace:Mapping_Tools.Components"
                            xmlns:domain="clr-namespace:Mapping_Tools.Components.Domain"
                            xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                            x:Class="Mapping_Tools.Avalonia.Views.HitsoundPreviewHelper.HitsoundPreviewHelperView"
                            x:Name="This">
    <views:SingleRunMappingTool.Resources>
        <domain:DoubleToStringConverter x:Key="DoubleConverter"/>
        <domain:IntToStringConverter x:Key="IntConverter"/>
    </views:SingleRunMappingTool.Resources>
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
        <c:ViewHeaderComponent ParentControl="{Binding #This}" HorizontalAlignment="Left"/>
        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="180"/>
                <DataGridTemplateColumn Header="X" Width="90">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><c:ValidatedTextBox Value="{Binding XPos}" Converter="{StaticResource DoubleConverter}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Y" Width="90">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><c:ValidatedTextBox Value="{Binding YPos}" Converter="{StaticResource DoubleConverter}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Hitsound" Width="120">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Hitsounds}" SelectedItem="{Binding Hitsound}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Sample set" Width="120">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding SampleSets}" SelectedItem="{Binding SampleSet}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Addition" Width="120">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding SampleSets}" SelectedItem="{Binding AdditionsSet}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Index" Width="90">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><c:ValidatedTextBox Value="{Binding CustomIndex}" Converter="{StaticResource IntConverter}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,10,0,0">
            <Button Theme="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Command="{Binding RhythmGuideCommand}" ToolTip.Tip="Open Rhythm Guide">
                <icons:MaterialIcon Kind="SineWave" Width="22" Height="22"/>
            </Button>
            <Button Grid.Column="1" Margin="8,0" Theme="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Command="{Binding AddCommand}" ToolTip.Tip="Add zone">
                <icons:MaterialIcon Kind="Plus" Width="22" Height="22"/>
            </Button>
            <Button Grid.Column="2" Theme="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Command="{Binding CopyCommand}" ToolTip.Tip="Copy selected zones">
                <icons:MaterialIcon Kind="ContentCopy" Width="22" Height="22"/>
            </Button>
            <Button Grid.Column="3" Margin="8,0" Theme="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove selected zones">
                <icons:MaterialIcon Kind="TrashCan" Width="22" Height="22"/>
            </Button>
            <CheckBox Grid.Column="4" HorizontalAlignment="Right" Content="Select all" IsChecked="{Binding IsAllItemsSelected}"/>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <ProgressBar Value="{Binding #This.Progress}" Height="10" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Margin="16,0,0,0" Theme="{StaticResource MaterialDesignFloatingActionButton}"
                    IsEnabled="{Binding #This.CanRun}" Click="Start_Click">
                <icons:MaterialIcon Kind="Play" Width="30" Height="30"/>
            </Button>
        </Grid>
    </Grid>
</views:SingleRunMappingTool>
