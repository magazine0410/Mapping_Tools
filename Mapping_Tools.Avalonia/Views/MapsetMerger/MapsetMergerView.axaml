<views:SingleRunMappingTool xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:views="clr-namespace:Mapping_Tools.Avalonia.Views"
                            xmlns:c="clr-namespace:Mapping_Tools.Components"
                            xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                            x:Class="Mapping_Tools.Avalonia.Views.MapsetMerger.MapsetMergerView"
                            x:Name="This">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
        <c:ViewHeaderComponent ParentControl="{Binding #This}" HorizontalAlignment="Left"/>
        <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Mapsets}"
                  AutoGenerateColumns="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                <DataGridTemplateColumn Header="Folder" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding Path}"/>
                                <Button Grid.Column="1" Theme="{StaticResource IconButton}" Command="{Binding BrowseCommand}">
                                    <icons:MaterialIcon Kind="Folder" Width="24" Height="24"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,10,0,0">
            <Button Theme="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Command="{Binding AddMapsetCommand}" ToolTip.Tip="Add mapset">
                <icons:MaterialIcon Kind="Plus" Width="24" Height="24"/>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Theme="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Command="{Binding RemoveMapsetCommand}" ToolTip.Tip="Remove selected mapsets">
                <icons:MaterialIcon Kind="Minus" Width="24" Height="24"/>
            </Button>
            <Grid Grid.Column="2" ColumnDefinitions="*,Auto" Margin="16,0">
                <TextBox Text="{Binding ExportPath}" PlaceholderText="Export folder"/>
                <Button Grid.Column="1" Theme="{StaticResource IconButton}" Command="{Binding BrowseExportPathCommand}">
                    <icons:MaterialIcon Kind="Folder" Width="24" Height="24"/>
                </Button>
            </Grid>
            <CheckBox Grid.Column="3" Content="Move storyboard into .osu" IsChecked="{Binding MoveSbToBeatmap}" VerticalAlignment="Center"/>
            <Button Grid.Column="4" Margin="12,0,0,0" Theme="{StaticResource MaterialDesignFloatingActionButton}"
                    IsEnabled="{Binding #This.CanRun}" Click="Start_Click">
                <icons:MaterialIcon Kind="Play" Width="30" Height="30"/>
            </Button>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock Text="Made by OliBomby" FontWeight="Bold" Opacity="0.58"/>
            <ProgressBar Grid.Column="1" Margin="20,0" Height="20" Value="{Binding #This.Progress}"/>
        </Grid>
    </Grid>
</views:SingleRunMappingTool>
