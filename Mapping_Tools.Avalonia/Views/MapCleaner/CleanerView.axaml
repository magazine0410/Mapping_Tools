<views:SingleRunMappingTool xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:views="clr-namespace:Mapping_Tools.Avalonia.Views"
                            xmlns:c="clr-namespace:Mapping_Tools.Components"
                            xmlns:domain="clr-namespace:Mapping_Tools.Components.Domain"
                            xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                            x:Class="Mapping_Tools.Avalonia.Views.MapCleaner.CleanerView"
                            x:Name="This">
    <views:SingleRunMappingTool.Resources>
        <domain:BeatDivisorArrayToStringConverter x:Key="BeatDivisorArrayToStringConverter"/>
    </views:SingleRunMappingTool.Resources>

    <Grid Margin="20" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <c:ViewHeaderComponent ParentControl="{Binding #This}" HorizontalAlignment="Left"/>

                    <CheckBox FontSize="14" Margin="0,10,0,0"
                              IsChecked="{Binding MapCleanerArgs.AnalyzeSamples}"
                              Content="Analyze samples"
                              ToolTip.Tip="Analyze the samples used by the beatmap to optimize greenlines further. Disable this if your beatmap uses custom hitsounds but the sound sample files are not yet added."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.ResnapObjects}"
                              Content="Resnap objects"
                              ToolTip.Tip="Resnap hit objects and slider ends."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.ResnapBookmarks}"
                              Content="Resnap bookmarks"
                              ToolTip.Tip="Resnap bookmarks."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.RemoveHitsounds}"
                              Content="Remove hitsounds"
                              ToolTip.Tip="Remove all hitsounds from the beatmap."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.RemoveUnusedSamples}"
                              Content="Remove unused samples"
                              ToolTip.Tip="Remove all samples that are unused by all maps and storyboards in the set."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.RemoveMuting}"
                              Content="Remove muting"
                              ToolTip.Tip="Remove all occurances of 5% volume on slider ends or spinner ends."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.RemoveUnclickableHitsounds}"
                              Content="Mute unclickable hitsounds"
                              ToolTip.Tip="Mute all slider ends/repeats and spinner ends."/>

                    <TextBlock Text="Map info" Margin="0,20,0,0" FontSize="14" FontWeight="Bold"/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.VolumeSliders}"
                              Content="Map uses volume changes in sliders"
                              ToolTip.Tip="Flag volume changes in sliders as useful, so they don't get removed."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.SampleSetSliders}"
                              Content="Map uses sampleset changes in sliders"
                              ToolTip.Tip="Flag sample set changes in sliders as useful, so they don't get removed."/>
                    <CheckBox FontSize="14" IsChecked="{Binding MapCleanerArgs.VolumeSpinners}"
                              Content="Map uses volume changes in spinners"
                              ToolTip.Tip="Flag volume changes in spinners as useful, so they don't get removed."/>

                    <TextBlock Text="Signatures" Margin="0,20,0,0" FontSize="14" FontWeight="Bold"
                               ToolTip.Tip="Choose the snap divisors to resnap to."/>
                    <c:ValidatedTextBox x:Name="BeatDivisorsBox"
                                        HorizontalAlignment="Left" MinWidth="160" FontSize="14"
                                        PlaceholderText="Beat divisors"
                                        Value="{Binding MapCleanerArgs.BeatDivisors, Mode=TwoWay}"
                                        Converter="{StaticResource BeatDivisorArrayToStringConverter}"
                                        ToolTip.Tip="Input any number of beat divisors here separated with commas. Example: 1/4, 1/12, 1/7, 4/5, 0.13435622499"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RunButton"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10"
                        Theme="{StaticResource MaterialDesignFloatingActionButton}"
                        IsEnabled="{Binding #This.CanRun}"
                        Click="Start_Click"
                        ToolTip.Tip="Run this tool.">
                    <icons:MaterialIcon Kind="Play" Height="30" Width="30"/>
                </Button>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="Made by OliBomby" FontWeight="Bold" Opacity="0.58"
                       VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="1" Margin="20,0,20,0" Height="20"
                         Value="{Binding #This.Progress}"/>
        </Grid>
    </Grid>
</views:SingleRunMappingTool>
